{
  "$schema": "https://firebase.google.com/schemas/blueprint/v1.json",
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "PhoneTicket": {
      "collection": "phoneTickets",
      "fields": {
        "ticketNo": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "countryIso": { "type": "string" },
        "areaCode": { "type": "string" },
        "fullNumber": { "type": "string" },
        "days": { "type": "number" },
        "rate": { "type": "number" },
        "callRecording": { "type": "boolean" },
        "addOns": { "type": "map" },
        "issuedAt": { "type": "timestamp" },
        "expiresAt": { "type": "timestamp" },
        "isLive": { "type": "boolean" }
      }
    },
    "SmsMessage": {
      "collection": "smsMessages",
      "fields": {
        "id": { "type": "string" },
        "ticketNo": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "body": { "type": "string" },
        "otpCode": { "type": "string" },
        "timestamp": { "type": "string" },
        "isRead": { "type": "boolean" },
        "isOutbound": { "type": "boolean" }
      }
    },
    "MailTicket": {
      "collection": "mailTickets",
      "fields": {
        "ticketNo": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "username": { "type": "string" },
        "domain": { "type": "string" },
        "fullAddress": { "type": "string" },
        "durationMins": { "type": "number" },
        "rate": { "type": "number" },
        "forwardToInbox": { "type": "boolean" },
        "issuedAt": { "type": "timestamp" },
        "expiresAt": { "type": "timestamp" },
        "isLive": { "type": "boolean" }
      }
    },
    "MailMessage": {
      "collection": "mailMessages",
      "fields": {
        "id": { "type": "string" },
        "ticketNo": { "type": "string" },
        "userId": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "subject": { "type": "string" },
        "preview": { "type": "string" },
        "body": { "type": "string" },
        "timestamp": { "type": "string" },
        "isRead": { "type": "boolean" },
        "isOutbound": { "type": "boolean" }
      }
    },
    "PaymentReceipt": {
      "collection": "paymentReceipts",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "ticketLabel": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "authCode": { "type": "string" },
        "transactionId": { "type": "string" },
        "timestamp": { "type": "timestamp" },
        "status": { "type": "string" },
        "cardLast4": { "type": "string" },
        "cardBrand": { "type": "string" }
      }
    }
  }
}
